# MongoDB connection string. A free MongoDB Atlas cluster (atlas.mongodb.com)
# works well: create a free M0 cluster, add a database user, allow your IP,
# and copy the connection string here.
MONGO_URI=mongodb://localhost:27017/ful-evas

# Used to sign login tokens. Change this to any long random string in production.
JWT_SECRET=dev-secret-change-me

PORT=4000

# Comma-separated list of frontend origins allowed to call this API
# (e.g. https://ful-evas.vercel.app). Leave blank in local dev to allow any
# origin; always set this in production.
CORS_ORIGIN=http://localhost:5173

# Optional — enables real building photos via Google Custom Search.
# Leave blank to use the bundled illustrated venue artwork instead.
# Setup: https://console.cloud.google.com/apis/credentials (API key)
#        https://programmablesearchengine.google.com/ (search engine ID / cx)
# Free tier: 100 queries/day.
GOOGLE_API_KEY=
GOOGLE_CX=
